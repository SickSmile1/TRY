            var objectLayer = mMap.GetLayer<TiledMapObjectLayer>("Objects");
            objectLayer.IsVisible = false;
            ObjectLayer = objectLayer;

            // Add enemys
            new Formation(mContent, BattleModeState, 700, 200);
            new Formation(mContent, BattleModeState, 1500, 200);
        }


        /// <summary>
        /// Initializes Players at spawn
        /// </summary>
        private void InitializePlayers()
        {
            foreach (var obj in ObjectLayer.Objects)
            {
                if (obj.Name == "Spawn")
                {
                    BattleModeState.AddPlayerCharacter(new Character(mAstronaut, obj.Position.ToPoint(), new Point(40, 86), mProjectile));
                }
            }
        }

        /// <summary>
        /// Initializes Doors
        /// </summary>
        private void InitializeDoors()
        {
            //Initialise doors
            var doorLayerLeft = mMap.GetLayer<TiledMapObjectLayer>("LeftDoors");
            var doorLayerRight = mMap.GetLayer<TiledMapObjectLayer>("RightDoors");
            doorLayerRight.IsVisible = false;
            doorLayerLeft.IsVisible = false;
            for (var index = 0; index <System.Math.Max(doorLayerLeft.Objects.Length, doorLayerRight.Objects.Length); index++)
            {
                BattleModeState.AddDoor(new Door(mLeftDoorTextureClosed, mLeftDoorTextureOpened, doorLayerLeft.Objects[index].Position, true));
                BattleModeState.AddDoor(new Door(mRightDoorTextureClosed, mRightDoorTextureOpened, doorLayerRight.Objects[index].Position, true));
            }
        }

        /// <summary>
        /// LoadContent will be called once per game and is the place to load
        /// all of your content.
        /// </summary>
        private void LoadContent()
        {
            // Load background, alien and projectile image.
            mAlien2 = mContent.Load<Texture2D>("Aliens/alien");
            mAlien = mContent.Load<Texture2D>("Aliens/space-invaders");
            mAstronaut = mContent.Load<Texture2D>("Characters/Support1/AstronautSprite");
            mRobot = mContent.Load<Texture2D>("Characters/Fernkampf1/Fernkampf1Sprite");
            mProjectile = mContent.Load<Texture2D>("Projectiles/Projectile");

            mTextures = new Dictionary<string, Texture2D>();
            mTextures.Add(mAlien.Name, mAlien);
            mTextures.Add(mAlien2.Name, mAlien2);
            mTextures.Add(mAstronaut.Name, mAstronaut);
            mTextures.Add(mRobot.Name, mRobot);

            mHealthBar = mContent.Load<Texture2D>("Utility/HealthBar");
            mEnergy = mContent.Load<Texture2D>("energy");
            mOxygen = mContent.Load<Texture2D>("oxygen");

            // Load Select Box texture, which is a dotted line.
            mDottedLine = mContent.Load<Texture2D>("Utility/DottedLine");

            // Load SoundEffect resource
            mSoundEffectInstance[0] = mContent.Load<SoundEffect>("Music/mativve__walking-5").CreateInstance();
            mSoundEffectInstance[1] = mContent.Load<SoundEffect>("Music/maxlandergard__smallorgan").CreateInstance();
            mSoundEffectInstance[0].IsLooped = true;
            mAudioEmitter = new AudioEmitter();
            mAudioListener = new AudioListener();

            //Map Loading
            mMap = mContent.Load<TiledMap>(assetName: "Map/BattleMap1");
            mLeftDoorTextureClosed = mContent.Load<Texture2D>("Map/LeftDoor");
            mRightDoorTextureClosed = mContent.Load<Texture2D>("Map/RightDoor");
            mLeftDoorTextureOpened = mContent.Load<Texture2D>("Map/LeftDoorOpened");
            mRightDoorTextureOpened = mContent.Load<Texture2D>("Map/RightDoorOpened");

            // At this Point just drawing these would be simpler.
            mPortraitSelected = new Texture2D(mGraphicsDevice, mPortraitWidth, mPortraitHeight);
            var color = new Color[mPortraitWidth * mPortraitHeight];
            for (var i = 0; i < color.Length; i++)
            {
                color[i] = Color.LightGreen;
            }
            mPortraitSelected.SetData(color);

            mPortraitUnselected = new Texture2D(mGraphicsDevice, mPortraitWidth, mPortraitHeight);
            var uColor = new Color[mPortraitWidth * mPortraitHeight];
            for (var i = 0; i < uColor.Length; i++)
            {
                uColor[i] = Color.Chocolate;
            }
            mPortraitUnselected.SetData(uColor);
        }

        public override void Draw(GameTime gameTime, SpriteBatch spriteBatch)
        {
            mGraphicsDevice.Clear(Color.Black);
            mInterfaceBatch.Begin();
            mSpriteBatch.Begin(transformMatrix: mMainCamera.GetViewMatrix());
            mMapRenderer.Draw(mMap, mMainCamera.GetViewMatrix());

            // Draw all Characters
            BattleModeState.Draw(mSpriteBatch, mHealthBar);

            // Drawing the selection box, mBattleModeState needed for the WorldtoScreen method, which will set the coordinates correctly. 
            mSelection.SelectionBox.Draw(mSpriteBatch);

            mUserInterface.Draw(mGraphicsDevice, mInterfaceBatch);

            mSpriteBatch.End();

            mInterfaceBatch.End();
        }

        /// <summary>
        /// Updates the main action of the Game
        /// </summary>
        public override void Update(GameTime gameTime)
        {
            mMapRenderer.Update(mMap, gameTime);
            mInputManager.Update(mMainCamera, mUserInterface, mGame, mGraphicsDevice, mContent, BattleModeState, mSelection);
            if (mGame.IsActive) mInputManager.Update(mMainCamera, mUserInterface, mGame, mGraphicsDevice, 
                mContent, BattleModeState, mSelection);
            BattleModeState.Update(gameTime);
        }
    }
}
