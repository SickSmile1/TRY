using System;
using System.Collections.Generic;
using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Audio;
using Microsoft.Xna.Framework.Content;
using Microsoft.Xna.Framework.Graphics;
using Microsoft.Xna.Framework.Media;
using MonoGame.Extended.Tiled;
using MonoGame.Extended.Tiled.Graphics;
using TRY.GameStates;
using TRY.Kampfmodus;
using TRY.Kampfmodus.Characters;
using TRY.SaveGame;

namespace TRY
{
    internal sealed class BattleMode : States
    {
        private SpriteBatch mSpriteBatch;
        private SpriteBatch mInterfaceBatch;

        //Textures and Ressources
        private Texture2D mAlien;
        private Texture2D mAlien2;
        private Texture2D mProjectile;
        private Texture2D mDottedLine;
        private Texture2D mAstronaut;
        private Texture2D mRobot;
        private Dictionary<string, Texture2D> mTextures;
        private Texture2D mEnergy;
        private Texture2D mOxygen;
        private UserInterface mUserInterface;
        public static SoundEffectInstance[] mSoundEffectInstance = new SoundEffectInstance[2];
        public static AudioEmitter mAudioEmitter;
        public static AudioListener mAudioListener;

        // Class instances
        public BattleModeState BattleModeState { get; set; }
        private InputManager mInputManager;
        private Selection mSelection;
        private Camera mMainCamera;

        //Map neccessaire
        private TiledMapRenderer mMapRenderer;
        private TiledMap mMap;
        private TiledMapObjectLayer ObjectLayer { get; set; }

        // Alle Variablen für die linken und rechten Türen. Die linke Tür an Position 0 passt 
        // zur rechten Tür an position 0.
        private Texture2D mLeftDoorTextureClosed;
        private Texture2D mLeftDoorTextureOpened;
        private Texture2D mRightDoorTextureClosed;
        private Texture2D mRightDoorTextureOpened;

        // User Interface
        private Texture2D mPortraitSelected;
        private Texture2D mPortraitUnselected;
        private Texture2D mHealthBar;
        private int mPortraitWidth = 50;
        private int mPortraitHeight = 50;

        private bool[,] mBlocked;
        private bool mLoad;

        public BattleMode(Game1 game, GraphicsDevice graphicsDevice, ContentManager content, bool load = false) : base(game, graphicsDevice, content)
        {
            mGame = game;
            mGraphicsDevice = graphicsDevice;
            mContent = content;
            mLoad = load;
            Initialize();
            Song song = content.Load<Song>("Music/Fight");
            MediaPlayer.Play(song);
        }

        /// <summary>
        /// Allows the game to perform any initialization it needs to before starting to run.
        /// This is where it can query for any required services and load any non-graphic
        /// related content.  Calling base.Initialize will enumerate through any components
        /// and initialize them as well.
        /// </summary>
        private void Initialize()
        {
            // create new camera object
            BattleModeState = new BattleModeState(mGraphicsDevice);
            mInputManager = InputManager.Instance;
            LoadContent();
            mSelection = new Selection(BattleModeState, new SelectionBox(mDottedLine));
            mUserInterface = new UserInterface(mPortraitUnselected, mPortraitSelected, BattleModeState, mSelection, mHealthBar);
            mInterfaceBatch = new SpriteBatch(mGraphicsDevice);
            mSpriteBatch = new SpriteBatch(mGraphicsDevice);
            mMainCamera = new Camera(mGraphicsDevice.Viewport, mMap.WidthInPixels, mMap.HeightInPixels);
            mMainCamera.Limits = new Rectangle(0, 0, (int)mMainCamera.mMapWidth, (int)mMainCamera.mMapHeight);


            InitializeMap();
            if (!mLoad)
            {
                InitializePlayers();
                InitializeDoors();
            }
            else
            {
                LoadFromFile load = new LoadFromFile();

                List<string> chars = load.ReturnChar();
                LoadPlayer(chars);

                chars = load.ReturnEnemy();
                LoadEnemy(chars);
            }
        }

        private void LoadPlayer(List<string> chars)
        {
            for (int i = 0; i< chars.Count; i += 4)
            {
                int x = Convert.ToInt32(chars[i]);
                int y = Convert.ToInt32(chars[i + 1]);
                var texture = mTextures[chars[i + 3]];
                BattleModeState.AddPlayerCharacter(new Character(texture, new Point(x, y), new Point(40, 86), mProjectile));
            }
        }

        private void LoadEnemy(List<string> chars)
        {
            for (int i = 0; i< chars.Count; i += 4)
            {
                int x = Convert.ToInt32(chars[i]);
                int y = Convert.ToInt32(chars[i + 1]);
                var texture = mTextures[chars[i + 3]];
                BattleModeState.AddNpc(new Character(texture, new Point(x, y), new Point(40, 86), mProjectile));
            }
        }

        /// <summary>
        /// Initializes Map and Collision field
        /// </summary>
        private void InitializeMap()
        {
            BattleModeState.AddItem(new CollectableItem(mOxygen, mEnergy, true, new Vector2(400, 100)));
            BattleModeState.AddItem(new CollectableItem(mOxygen, mEnergy, false, new Vector2(300, 100)));

            //Initialise Map
            mMapRenderer = new TiledMapRenderer(mGraphicsDevice);
            //Convert the collision layer to a bool array of blocked pixels
            var collisionLayer = mMap.GetLayer<TiledMapObjectLayer>("CollisionObjects");
            mBlocked = new bool[mMap.WidthInPixels,mMap.HeightInPixels];
            foreach (var collisionObject in collisionLayer.Objects)
            {
                for (var x = (int) collisionObject.Position.X; x <= (int) collisionObject.Size.Width + collisionObject.Position.X; x++)
                {
                    for (var y = (int) collisionObject.Position.Y; y <= (int) collisionObject.Size.Height + collisionObject.Position.Y; y++)
                    {
                        mBlocked[x, y] = true;
                    }
                }
            }

