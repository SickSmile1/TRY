using System.Collections.Generic;
using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Graphics;

namespace TRY.Kampfmodus
{
    class UserInterface
    {
        private readonly BattleModeState mBms;
        private readonly Selection mSelection;
        private readonly float mPortraitBorderX;
        private readonly float mPortraitBorderY;
        private readonly int mPortraitWidth;
        private Texture2D mPortraitSelected;
        private Texture2D mPortraitUnselected;
        private readonly Texture2D mAbilityActive;
        private readonly Texture2D mMineA;
        private readonly Texture2D mAbilityNotActive;
        private readonly HealthBar mHealthBar;
        private readonly SpriteFont mFont;


        public UserInterface(Texture2D portraitUnselected, Texture2D portraitSelected, BattleModeState bms,
                             Selection select, Texture2D healthBar, SpriteFont font, Texture2D abilActive, Texture2D abilNotActive)
        {
            mPortraitUnselected = portraitUnselected;
            mPortraitSelected = portraitSelected;
            mBms = bms;
            mSelection = select;
            mHealthBar = new HealthBar(healthBar);
            mPortraitBorderX = 50f;
            mPortraitBorderY = 50f;
            mPortraitWidth = 70;
            mFont = font;
            mAbilityActive = abilActive;
            mAbilityNotActive = abilNotActive;
        }

        public bool SelectInterface(Point clickPoint)
        {
            var nChar = 0;
            mSelection.UnselectAll();
            foreach (var ch in mBms.GetPlayerCharacters())
            {
                var rect = new Rectangle((int)mPortraitBorderX + (int)(mPortraitWidth + mPortraitBorderX) * nChar,
                                         (int)mPortraitBorderY, mPortraitWidth, mPortraitWidth);
                if (rect.Contains(clickPoint))
                {
                    mSelection.SelectCharacter(ch);
                    return true;
                }

                nChar++;
            }
            return false;
        }


